# Скопировать в .env и подставить свои значения. Сам .env в git не едет.

# Адрес LM Studio на домашней машине — её IP внутри WireGuard-туннеля,
# не белый адрес и не localhost: localhost для контейнера это он сам.
LMS_URL=http://10.0.0.2:1234/v1

# id моделей ровно в том виде, в каком их отдаёт <LMS_URL>/models
EMBED_MODEL=text-embedding-bge-m3
CHAT_MODEL=google/gemma-4-12b

# Сколько фрагментов уходит в модель и ниже какой близости не звать её вообще.
# Менять можно на лету: перезапуск контейнера, переиндексация не нужна.
TOP_K=8
MIN_SCORE=0.55
